# Local-only API server. Do not commit your real .env file.
HOST=127.0.0.1
PORT=3001
FRONTEND_DIST_DIR=../dist
DATA_DIR=./applications
# Admin knowledge-base edits are stored locally and survive server restarts.
KNOWLEDGE_BASE_FILE=../.local/data/knowledge-base.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aiscu.xuyuzu.online

# `local` uses the Chroma container in docker-compose.local.yml.
# Set to `cloud` only when the three CHROMA_* values below are configured.
VECTOR_STORE=local
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=aiscu_rag_collection
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=default_database

# Kept on this computer only. Never use a VITE_ prefix for server secrets.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=15000
# Maximum time to retrieve a web page before its content is sent to Gemini.
URL_IMPORT_TIMEOUT_MS=20000
APPLICATION_ENCRYPTION_KEY=

# Local operational log. It contains endpoint, status, duration and errors,
# but never API keys or request body contents.
LOG_FILE=../.local/logs/backend.log
